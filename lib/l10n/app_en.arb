  "changelog": "Changelog",
  "changelog_1_1_0_1": "Adaptive icon (SVG design, fills tablet icon area)",
  "changelog_1_1_0_2": "Settings page footer logo with theme tint",
  "changelog_1_1_0_3": "Auto-sync persistence (survives app restart)",
  "changelog_1_1_0_4": "Own messages on left layout option",
  "changelog_1_1_0_5": "Portable mode as data-location picker dialog",
  "changelog_1_1_0_6": "Full English localization (no hardcoded Chinese left)",
  "changelog_1_1_0_7": "Content max-width 700px, pending page same constraint",
  "changelog_1_1_0_8": "NavigationRail adapts to screen width (tablet landscape)",
  "changelog_1_1_0_9": "APK slimmed to 19.5MB (arm64 only + minify)",
  "changelog_1_1_0_10": "Settings entry row height unified",
  "changelog_1_1_0_11": "Config import/export (JSON sharing)",
  "changelog_1_1_0_12": "Storage usage widget with clear button",
  "changelog_1_1_0_13": "Server enable/disable toggle",
  "changelog_1_1_0_14": "Server emoji icon picker",
  "changelog_1_1_0_15": "Drag & drop with instant/pending modes",
  "changelog_1_1_0_16": "Upload failure auto-fallback to pending page",
  "changelog_1_1_0_17": "Error messages show HTTP status, URL, auth details",
  "changelog_1_1_0_18": "Serialized init to avoid concurrent PROPFIND",
  "changelog_1_0_0_1": "WebDAV-based text bridge with chat interface",
  "changelog_1_0_0_2": "File depot with folder navigation & multi-file upload",
  "changelog_1_0_0_3": "Multi-server support with separate text/files selection",
  "changelog_1_0_0_4": "Upload/download queue with progress tracking",
  "changelog_1_0_0_5": "Auto-pull for new messages",
  "changelog_1_0_0_6": "Theme mode, color picker, dynamic color (Material You)",
  "changelog_1_0_0_7": "English/Chinese localization",
  "changelog_1_0_0_8": "Window size/position remembered on desktop",
  "changelog_1_0_0_9": "Portable mode (config.json next to executable)",
  "changelog_1_0_0_10": "Original app icon design",

